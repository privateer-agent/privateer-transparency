# Privateer — environment variable NAMES referenced by the code in this repo.
#
# This file documents variable *names* only. Real values live in our deployment
# environment and are NEVER committed. No secret in this repo is real. This is a
# transparency excerpt, not a runnable build — these are here so the
# `process.env.*` reads in the published server code are explained, not so the
# excerpt can boot.
#
# Anything billing/entitlement/infra-related (Stripe keys, S3 creds, Mongo URI,
# Redis URL, JWT signing keys, email/Sentry tokens, etc.) belongs to the CLOSED
# server and is intentionally absent here.

# ── Inference: OpenRouter (Zero-Data-Retention enforcement) ──────────────────
# Two keys back the ZDR guarantee structurally: an account-level ZDR key for
# ZDR-required requests, and a standard key for explicitly-opted-out / non-ZDR
# media. See server/services/inferenceService.js (orHeaders / resolveUseZdrKey).
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_ZDR=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PROVIDER_SORT=

# ── Inference: NEAR AI (confidential-compute / TEE models) ───────────────────
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=

# ── Model defaults ───────────────────────────────────────────────────────────
DEFAULT_MODEL_ID=
DEFAULT_VIDEO_MODEL=

# ── Timeouts (SSE/edge ordering; see media-timeout handling) ─────────────────
OR_TEXT_TIMEOUT_MS=
OR_MEDIA_TIMEOUT_MS=
NEAR_TEXT_TIMEOUT_MS=

# ── Auth ─────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
SERVER_URL=
USE_TRANSACTIONS=
